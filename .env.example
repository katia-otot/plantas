# Copy to .env — never commit real secrets / service account JSON.

DATABASE_URL="file:./data/app.db"
AUTH_SECRET=
# Canonical site URL (include Next basePath on VPS). Auth API path is set in code
# to `{BASE_PATH}/api/auth` so this must not be used as Auth's basePath alone.
AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_PATH=/plantas
# AUTH_URL=http://149.50.156.136/plantas
# AUTH_OWNER_EMAILS=

# Firebase Admin (ID token verify + FCM). Prefer PATH on the VPS.
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Set to 1 on VPS once Admin credentials work (locks routes behind login).
# FIREBASE_AUTH_REQUIRED=1

# Optional overrides (defaults = plantas-patio web app)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=plantas-patio.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=plantas-patio
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=plantas-patio.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_BRIDGE_URL=https://plantas-patio.web.app/auth-login.html
